# Example environment variables for Datuvera
POSTGRES_USER=datuvera
POSTGRES_PASSWORD=datuvera
POSTGRES_DB=datuvera
POSTGRES_HOST=datuvera-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://datuvera:datuvera@datuvera-db:5432/datuvera
API_URL=http://datuvera-api:8000
WEB_PORT=3000
API_PORT=8000
POSTGRES_HOST=datuvera-db
POSTGRES_USER=datuvera
POSTGRES_PASSWORD=datuvera

# Notes:
# - For local development you can set API_URL to http://localhost:8000
# - For Docker Compose, services communicate via the compose network using service names (e.g. datuvera-api)
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
