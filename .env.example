# Local development only. Replace credentials before exposing this environment.
POSTGRES_USER=datuvera
POSTGRES_PASSWORD=datuvera
POSTGRES_DB=datuvera
DATABASE_URL=postgresql+psycopg://datuvera:datuvera@datuvera-db:5432/datuvera
API_URL=http://datuvera-api:8000
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development

# Optional existing-volume adoption: see README before using these settings.
# DATUVERA_DB_VOLUME=<existing internal volume name>
# DATUVERA_DEMO_DB_VOLUME=<existing demo volume name>
# DATUVERA_EXTERNAL_VOLUMES=true

# Optional AI interpretation; core profiling/quality require no API key.
DATUVERA_AI_ENABLED=false
OPENAI_API_KEY=
DATUVERA_AI_MODEL=gpt-5.4-mini
